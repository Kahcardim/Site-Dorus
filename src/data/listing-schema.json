      "@type": "FAQPage",
      "@id": "https://assistenciadorus.com.br/servicos/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Como funciona a visita técnica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O cliente informa o problema e a região. A data é combinada conforme disponibilidade, e a visita é realizada no endereço informado."
          }
        },
        {
          "@type": "Question",
          "name": "Como é feito o orçamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "As condições do orçamento são alinhadas após a avaliação do aparelho e a explicação do serviço recomendado."
          }
        },
        {
          "@type": "Question",
          "name": "Qual é o prazo do serviço?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O prazo depende do diagnóstico, da complexidade do reparo e da disponibilidade de peças. A previsão é informada após a avaliação."
          }
        },
        {
          "@type": "Question",
          "name": "Os serviços têm garantia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Os serviços executados pela D’orus têm garantia mínima de 90 dias, conforme as condições registradas na ordem de serviço."
          }
        },
        {
          "@type": "Question",
          "name": "Quais regiões recebem atendimento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Há atendimento no Centro de Guarulhos, Lago dos Patos, Bonsucesso e Pimentas. São Paulo é atendida sob consulta e conforme disponibilidade."
          }
        }
      ]
    }
